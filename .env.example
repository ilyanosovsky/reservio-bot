# Copy to .env and fill in. Never commit .env (it is gitignored).

# --- Default profile: contact used for guest bookings ---
# email = the email of YOUR Reservio account, so the booking is linked to it.
CLIENT_NAME="Your Name"
CLIENT_EMAIL="you@example.com"
CLIENT_PHONE="+000000000000"

# --- Extra engine profile (multi-profile) — example, commented out ---
# A second player: own email / times / court priority. Key K is uppercase
# letters/digits; a profile is added by config alone, no code change
# (src/core/profiles.ts). The profile id in scripts/seed-profiles.ts / the
# bot's `profiles` table must equal K lowercased, otherwise book-slot-drop
# won't find the contact by profileId (see docs/wiki/Bot.md).
# PROFILE_ANNA_NAME="Anna ..."
# PROFILE_ANNA_EMAIL="anna@example.com"
# PROFILE_ANNA_PHONE="+000000000000"
# PROFILE_ANNA_TIMES="19:00"
# PROFILE_ANNA_COURTS="Padel Court 1,Padel Court 4"
# PROFILE_ANNA_DAYS="2,4"
# PROFILE_ANNA_TELEGRAM_CHAT_ID=

# --- trigger.dev (cron / jobs) ---
# Project ref from your trigger.dev dashboard (starts with proj_).
TRIGGER_PROJECT_REF=proj_your_project_ref
TRIGGER_SECRET_KEY_DEV=
TRIGGER_SECRET_KEY_PROD=
# Needed by the BOT PROCESS (`pnpm bot`) to schedule "in 2 hours" reminders
# after a chat booking: src/bot/reminder.ts uses the first non-empty of
# TRIGGER_SECRET_KEY / _PROD / _DEV. If unset, the bot still runs but does not
# schedule reminders. Inside trigger.dev tasks the platform injects the key.
# TRIGGER_SECRET_KEY=

# --- Anthropic (phase 5: free-form query parsing, Haiku model) ---
ANTHROPIC_API_KEY=

# --- Supabase (shared state) ---
# Dashboard -> Project Settings -> API Keys -> Secret key (sb_secret_...).
# Used by the cloud drop (bookings table) and the bot (profiles, schedules,
# skips, settings — src/core/repos.ts, supabase/migrations/*).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only for local migrations via the Supabase CLI (session pooler connection
# string). Not needed at runtime.
# SUPABASE_DB_URL=

# --- Telegram (evening drop report + inbound bot) ---
# Both are required, otherwise the evening report goes nowhere and the night
# passes silently. BotFather -> /newbot -> token; chat_id — message the bot,
# then open https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN is also used by `pnpm bot` (src/bot/index.ts,
# long-polling) — same token. TELEGRAM_CHAT_ID is the owner's chat id;
# scripts/seed-profiles.ts creates the admin profile from it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Bot: optional ---
# Owner profile label in the bot UI (read by scripts/seed-profiles.ts).
# PROFILE_ILYA_LABEL="Owner"
# BOT_DEBUG=true logs the chat_id of rejected users (src/bot/auth.ts).
# Local debugging only ("why is the bot silent to me?") — chat_id identifies a
# person, don't leave this on in production.
# BOT_DEBUG=
