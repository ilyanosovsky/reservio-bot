# --- Профиль по умолчанию: контакт для guest-брони ---
# email = email твоего Reservio-аккаунта: бронь привяжется к личному кабинету
CLIENT_NAME="Ilya ..."
CLIENT_EMAIL="you@example.com"
CLIENT_PHONE="+995..."

# --- Доп. профиль движка (мультипрофили) — пример, закомментирован ---
# Второй игрок: свой email/времена/приоритет кортов. Ключ K — заглавные
# буквы/цифры, добавляется без изменения кода (src/core/profiles.ts). id
# профиля в scripts/seed-profiles.ts / таблице `profiles` бота должен
# совпадать с K в нижнем регистре — иначе book-slot-drop не найдёт контакт
# по profileId (см. docs/wiki/Bot.md → «Профиль в БД vs профиль движка»).
# PROFILE_ANNA_NAME="Anna ..."
# PROFILE_ANNA_EMAIL="anna@example.com"
# PROFILE_ANNA_PHONE="+995..."
# PROFILE_ANNA_TIMES="19:00"
# PROFILE_ANNA_COURTS="Padel Court 1,Padel Court 4"
# PROFILE_ANNA_DAYS="2,4"
# PROFILE_ANNA_TELEGRAM_CHAT_ID=

# --- trigger.dev (cron/джобы), project ref proj_fxjnzqesxsicrpeuepzv ---
TRIGGER_SECRET_KEY_DEV=
TRIGGER_SECRET_KEY_PROD=
# Нужен ПРОЦЕССУ БОТА (`pnpm bot`), чтобы ставить напоминания «⏰ через 2 часа»
# после брони из чата: src/bot/reminder.ts берёт первый непустой из
# TRIGGER_SECRET_KEY / _PROD / _DEV. Не задан — бот работает штатно, но
# напоминания не планируются (в лог уйдёт «напоминания выключены»).
# Внутри самих тасков trigger.dev ключ подставляет платформа — там он не нужен.
# TRIGGER_SECRET_KEY=

# --- Anthropic (фаза 5: парсинг свободных запросов, модель Haiku) ---
ANTHROPIC_API_KEY=

# --- Supabase (общий state; project id kbwmrqoxjlydmwyxirqm) ---
# Dashboard -> Project Settings -> API Keys -> Secret key (sb_secret_...)
# Используется и облачным дропом (таблица bookings), и ботом (профили,
# расписания, скипы, settings — src/core/repos.ts, миграция
# supabase/migrations/20260731110000_bot_core.sql).
SUPABASE_URL=https://kbwmrqoxjlydmwyxirqm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram (отчёт о вечернем дропе + входящий бот) ---
# Нужны ОБЕ переменные: без любой из них отчёт не уйдёт никуда и вечер
# пройдёт молча. BotFather -> /newbot -> токен; chat_id — написать боту и
# открыть https://api.telegram.org/bot<TOKEN>/getUpdates
# TELEGRAM_BOT_TOKEN нужен и для `pnpm bot` (src/bot/index.ts, long-polling) —
# это тот же токен, отдельного заводить не нужно. TELEGRAM_CHAT_ID — chat_id
# владельца; scripts/seed-profiles.ts заводит по нему профиль-администратора.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Бот: необязательное ---
# Подпись профиля-владельца в интерфейсе бота (кого читает
# scripts/seed-profiles.ts). Не задано — «Илья».
# PROFILE_ILYA_LABEL="Илья"
# BOT_DEBUG=true печатает chat_id отказников в лог процесса (src/bot/auth.ts).
# Только для локальной отладки «почему бот мне молчит»: chat_id — это
# идентификатор человека, в проде оставлять включённым не нужно.
# BOT_DEBUG=
